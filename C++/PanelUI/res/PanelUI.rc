// PanelUI.rc — 图标 / 清单 / 版本信息
#include "resource.h"
#include <windows.h>

IDI_APP_ICON  ICON  "app.ico"

1 24 "PanelUI.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,3,0,0
 PRODUCTVERSION  0,3,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Panel UI"
            VALUE "FileDescription",  "Panel UI - glass control panel"
            VALUE "FileVersion",      "0.3.0.0"
            VALUE "InternalName",     "PanelUI"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "PanelUI.exe"
            VALUE "ProductName",      "Panel UI"
            VALUE "ProductVersion",   "0.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
